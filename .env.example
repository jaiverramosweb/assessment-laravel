APP_NAME="Plataforma de Assessments"
# production on the server; local on your machine (session cookies are not Secure in local).
APP_ENV=local
# Generated with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Public URL; used to build invitation links. Production: https://assesment.sisteltestserver.com
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development: SQLite (database/database.sqlite).
DB_CONNECTION=sqlite
# Production on cPanel: MySQL/MariaDB (the host's SQLite is too old). Replace the line above with:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=usuario_assessments
# DB_USERNAME=usuario_assessments
# DB_PASSWORD=
# Program used by "php artisan db:backup" on MySQL (default: mysqldump from the PATH).
# MYSQLDUMP_PATH=/usr/bin/mysqldump

# Laravel's own session (CSRF and one-shot messages). Admin and participant sessions are
# stored in the database tables admin_sessions / participant_sessions.
SESSION_DRIVER=file
SESSION_LIFETIME=720
# Session files are encrypted with APP_KEY (they may briefly hold a copyable invitation message).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS)
SESSION_SECURE_COOKIE=false

# Queued jobs (AI analysis) are processed by the cron: php artisan schedule:run
QUEUE_CONNECTION=database
# Must be longer than the AI job timeout (about 19 minutes with AI_TIMEOUT_MS=180000).
DB_QUEUE_RETRY_AFTER=1200
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Behind a reverse proxy, list its IPs (or *) so the real visitor IP is used for rate limiting.
TRUSTED_PROXIES=

# Session lifetimes in hours (renewed with use; admin sessions always end after 7 days).
ADMIN_SESSION_HOURS=12
PARTICIPANT_SESSION_HOURS=72

# 64 hex chars to encrypt access passwords. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# When empty, the key is created in database/clave-cifrado.key (include it in backups).
ACCESS_PASSWORD_KEY=

# AI analysis (Anthropic). Without a key, AI analysis is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=180000

# Email for invitations. With MAIL_MAILER=log emails are written to storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="Assessments"
